diff --git a/third_party/PS2Recomp/ps2xRuntime/include/runtime/ps2_vu1_neon.h b/third_party/PS2Recomp/ps2xRuntime/include/runtime/ps2_vu1_neon.h
new file mode 100644
index 0000000..a72b1f1
--- /dev/null
+++ b/third_party/PS2Recomp/ps2xRuntime/include/runtime/ps2_vu1_neon.h
@@ -0,0 +1,122 @@
+// [gta-recomp] vu1neon: the vu1v vector helpers (ps2_vu1_compiled.h) for AArch64 NEON (Switch port M10-03).
+//
+// On a host without AVX, vu1v is a struct of four floats and its fused multiply-add computes every lane in double
+// precision (vu1fast::exactResult per lane, always). The AVX path first proves with a float test that the float
+// result is already the exact one (all but rare lanes) and falls back to doubles only for the rest. This header is that
+// AVX path for NEON, with the same rules lane for lane:
+// - operand: denormals -> signed zero, Inf / NaN -> signed max (integer masks, as the AVX path)
+// - max / min: (a > b) ? a : b and (a < b) ? a : b, i.e. SSE's MAXPS / MINPS (the second operand when equal) by a
+//   compare and a select - not vmaxq / vminq, which order +0 / -0 differently
+// - mul / add / sub: one IEEE operation each under the thread's FPCR (rounding mode, flush), never fused: the callers
+//   are compiled with -ffp-contract=off, and no vfma intrinsic is used
+// - fused<Dest, Subtract>: c +/- fl(a * b) when every written lane passes the AVX path's range test or has a zero
+//   operand; otherwise vu1fast::exactResult per written lane on the double value, as the AVX path
+// - store<Dest>: only the written lanes.
+// A separate namespace, not a third branch of vu1v: the generated VU1 code (a private archive compiled against
+// vu1v's scalar branch) keeps its own definitions, so no inline function has two definitions in one program. Used by
+// src/game/vcs_vu0_native.cpp on AArch64; PS2X_VU0_VERIFY=1 checks the natives against the interpreter on live data.
+#pragma once
+
+#if defined(__aarch64__)
+#include <arm_neon.h>
+#include <cstdint>
+#include <cstring>
+
+#include "runtime/ps2_vu1_compiled.h"
+
+namespace vu1neon
+{
+    using V = float32x4_t;
+
+    VU1_FORCEINLINE V load(const float *p) { return vld1q_f32(p); }
+    VU1_FORCEINLINE V splat(float value) { return vdupq_n_f32(value); }
+    VU1_FORCEINLINE V add(V a, V b) { return vaddq_f32(a, b); }
+    VU1_FORCEINLINE V sub(V a, V b) { return vsubq_f32(a, b); }
+    VU1_FORCEINLINE V mul(V a, V b) { return vmulq_f32(a, b); }
+    VU1_FORCEINLINE V max(V a, V b) { return vbslq_f32(vcgtq_f32(a, b), a, b); }
+    VU1_FORCEINLINE V min(V a, V b) { return vbslq_f32(vcltq_f32(a, b), a, b); }
+    VU1_FORCEINLINE V abs(V value)
+    {
+        return vreinterpretq_f32_u32(vandq_u32(vreinterpretq_u32_f32(value), vdupq_n_u32(0x7FFFFFFFu)));
+    }
+
+    // = vu1fast::operand per lane
+    VU1_FORCEINLINE V operand(V value)
+    {
+        const uint32x4_t bits = vreinterpretq_u32_f32(value);
+        const uint32x4_t exponent = vandq_u32(bits, vdupq_n_u32(0x7F800000u));
+        const uint32x4_t sign = vandq_u32(bits, vdupq_n_u32(0x80000000u));
+        uint32x4_t out = vbslq_u32(vceqq_u32(exponent, vdupq_n_u32(0u)), sign, bits);
+        out = vbslq_u32(vceqq_u32(exponent, vdupq_n_u32(0x7F800000u)), vorrq_u32(sign, vdupq_n_u32(0x7F7FFFFFu)), out);
+        return vreinterpretq_f32_u32(out);
+    }
+
+    // acc +/- a * b as vu1v::fused (AVX path): see ps2_vu1_compiled.h for why the float test suffices
+    template <unsigned Dest, bool Subtract>
+    VU1_FORCEINLINE V fused(V c, V a, V b)
+    {
+        const V floatProduct = vmulq_f32(a, b);
+        const V value = Subtract ? vsubq_f32(c, floatProduct) : vaddq_f32(c, floatProduct);
+        const V magnitude = vabsq_f32(value);
+        const uint32x4_t inRange =
+            vandq_u32(vandq_u32(vcgeq_f32(magnitude, vdupq_n_f32(0x1p-100f)), vcleq_f32(magnitude, vdupq_n_f32(0x1p126f))),
+                      vcleq_f32(vabsq_f32(floatProduct), vmulq_f32(magnitude, vdupq_n_f32(0x1p20f))));
+        const uint32x4_t zeroOperand = vorrq_u32(vceqq_f32(a, vdupq_n_f32(0.0f)), vceqq_f32(b, vdupq_n_f32(0.0f)));
+        // every written lane fine: the lanes not written count as fine, and the lowest lane is all ones. In registers -
+        // a store of the mask read back per lane stalled the A57 (a narrow load from a wide store does not forward:
+        // about half of the natives' samples, route-prof6-docked)
+        const uint32x4_t unwritten = {(Dest & 1u) ? 0u : ~0u, (Dest & 2u) ? 0u : ~0u, (Dest & 4u) ? 0u : ~0u,
+                                      (Dest & 8u) ? 0u : ~0u};
+        if (vminvq_u32(vorrq_u32(vorrq_u32(inRange, zeroOperand), unwritten)) == ~0u)
+            return value;
+        alignas(16) float values[4], cs[4], as[4], bs[4];
+        vst1q_f32(values, value);
+        vst1q_f32(cs, c);
+        vst1q_f32(as, a);
+        vst1q_f32(bs, b);
+        for (unsigned k = 0; k < 4u; ++k)
+        {
+            if ((Dest & (1u << k)) == 0u)
+                continue;
+            const double product = static_cast<double>(as[k]) * static_cast<double>(bs[k]);
+            const double exact = Subtract ? static_cast<double>(cs[k]) - product : static_cast<double>(cs[k]) + product;
+            values[k] = vu1fast::exactResult(values[k], exact);
+        }
+        return vld1q_f32(values);
+    }
+
+    // static_cast<float>(int32 lane bits) (/ divisor), under the thread's rounding mode as the scalar conversion
+    VU1_FORCEINLINE V intToFloat(V bits) { return vcvtq_f32_s32(vreinterpretq_s32_f32(bits)); }
+    VU1_FORCEINLINE V intToFloat(V bits, float divisor) { return vdivq_f32(intToFloat(bits), vdupq_n_f32(divisor)); }
+
+    // (x, y, z, w) -> (y, z, x, w) and (z, x, y, w)
+    VU1_FORCEINLINE V yzx(V v)
+    {
+        const V r = {vgetq_lane_f32(v, 1), vgetq_lane_f32(v, 2), vgetq_lane_f32(v, 0), vgetq_lane_f32(v, 3)};
+        return r;
+    }
+    VU1_FORCEINLINE V zxy(V v)
+    {
+        const V r = {vgetq_lane_f32(v, 2), vgetq_lane_f32(v, 0), vgetq_lane_f32(v, 1), vgetq_lane_f32(v, 3)};
+        return r;
+    }
+
+    template <unsigned Dest>
